# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://kpqunlmsixadfabltupo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Hosts / countries
ADMIN_HOST=admin.iho.com.mx
DEFAULT_COUNTRY=mx
# Public origin used for absolute links in emails and .ics files (no trailing slash).
SITE_URL=https://www.iho.com.mx

# Signing secret for download-access and draft cookies (any long random string).
IHO_COOKIE_SECRET=

# Email (Resend). Without it, notifications are skipped and logged.
RESEND_API_KEY=
EMAIL_FROM="Grupo IHO <no-reply@iho.com.mx>"
# Fallback inbox for contact / registration notifications when the country has no email set in the admin.
CONTACT_NOTIFY_EMAIL=

# Anti-spam (Cloudflare Turnstile). Optional; honeypot + rate limit always on.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Draft mode preview token
DRAFT_MODE_SECRET=
